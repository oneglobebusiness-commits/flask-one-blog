# Required
MONGO_URI=mongodb://localhost:27017/blog1
JWT_SECRET=change-me-to-a-long-random-string
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,write_content,write_files,read_files
SHOPIFY_CALLBACK_URL=https://your-domain.example/api/v1/integrations/shopify/callback

# Optional
# Database name, used only when MONGO_URI does not contain one. The old NestJS app defaulted to "test".
MONGO_DB=test
# First admin account. No admin is created unless both are set.
ADMIN_EMAIL=
ADMIN_PASSWORD=
SHOPIFY_API_VERSION=2026-04
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
UPLOAD_DIR=uploads
ENABLE_SCHEDULER=true
# Set to true when running behind a reverse proxy such as DigitalOcean App Platform.
TRUST_PROXY=false
PORT=5000
